{
  "name": "herbal-multidb-mcp",
  "version": "0.1.0",
  "description": "Multi-project database MCP server — MySQL, PostgreSQL, Redis, MongoDB with read-only protection",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "herbal-multidb-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "config.example.yaml",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "keywords": [
    "mcp",
    "database",
    "mysql",
    "postgresql",
    "redis",
    "mongodb",
    "claude",
    "cursor",
    "ai"
  ],
  "author": "holtye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CNyezi/herbal-multidb-mcp"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ioredis": "^5.10.1",
    "minimatch": "^10.2.5",
    "mongodb": "^7.1.1",
    "mysql2": "^3.22.0",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
